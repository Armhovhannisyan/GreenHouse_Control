# eWeLink OAuth (recommended) — from https://dev.ewelink.cc/ App Management
# Redirect URL in the developer console must match EWELINK_OAUTH_REDIRECT_URL exactly.
EWELINK_APP_ID=
EWELINK_APP_SECRET=
EWELINK_OAUTH_REDIRECT_URL=http://localhost:3001/api/sonoff/oauth/callback

# eWeLink legacy (optional fallback) — often blocked by CoolKit; prefer OAuth above
EWELINK_EMAIL=
EWELINK_PASSWORD=
EWELINK_REGION=eu

# Background poll: device list is written to db/sonoff-devices-cache.json; GET /api/sonoff/devices reads the file (UI does not hit eWeLink each click).
# SONOFF_DEVICES_POLL_MS=30000

# Optional: PLC / meteo station polled server-side (same paths as greenhouse/js/config sensorEndpoints). UI uses GET /api/sensors/station when sensorBaseUrl is empty in config.js.
# SENSOR_STATION_BASE_URL=http://192.168.1.100
# SENSOR_STATION_POLL_MS=30000

# Aranet MQTT ingest (optional)
# Example:
# ARANET_MQTT_URL=mqtt://192.168.1.50:1883
# Must match Aranet "Root topic" + /#  (e.g. Growsmart/# or aranet/#)
ARANET_MQTT_URL=
# Match Aranet root topic; must quote if using # wildcard (else # starts a comment).
# ARANET_MQTT_TOPIC="Growsmart/#"
ARANET_MQTT_TOPIC=aranet/#
ARANET_MQTT_USERNAME=
ARANET_MQTT_PASSWORD=
ARANET_MQTT_CLIENT_ID=greenctrl-aranet
# Optional: how many recent raw messages to keep for UI (default 40, max 100).
# ARANET_MQTT_RECENT_CAP=40
# Log every MQTT publish to backend.log (first message is always logged once).
# ARANET_MQTT_LOG_MESSAGES=true

# Optional: force data/static paths (Docker image sets this automatically when layout is /app).
# GREENCTRL_APP_ROOT=/app

# InfluxDB 2 (optional time-series). From repo root: docker compose up -d influxdb
# Local npm start: INFLUX_URL=http://localhost:8086
# Docker Compose overrides INFLUX_URL to http://influxdb:8086 — keep token/org/bucket in sync.
# INFLUX_URL=http://localhost:8086
# INFLUX_TOKEN=greenctrl-local-influx-token-replace-for-prod
# INFLUX_ORG=greenctrl
# INFLUX_BUCKET=greenhouse
#
# PWS weather → measurement `weather`, tag `station_id`, fields temperature_2m, relative_humidity_2m,
# wind_speed_10m, shortwave_radiation, etc. (see influx-writer.js). Always written when Influx is enabled,
# on every successful poll when obsTimeUtc is present (JSON file still only appends new observation times).
# INFLUX_WRITE_MQTT=true
# INFLUX_WRITE_ARANET_STATE=true
# JSON payloads → measurement aranet_sensor (tags gateway, sensor); set false to skip.
# INFLUX_WRITE_ARANET_SENSOR_DOC=true
# INFLUX_ARANET_SENSOR_MAX_FIELDS=80
#
# Daily drainage chart (Precision Growing) — field must exist on aranet_sensor JSON (sanitized key).
# INFLUX_DRAINAGE_MEASUREMENT=aranet_sensor
# INFLUX_DRAINAGE_FIELD=drainage_volume
# INFLUX_DRAINAGE_SENSOR=          # optional: Aranet MQTT sensor id tag when multiple probes
# INFLUX_DRAINAGE_VALUE_MODE=increment   # increment | cumulative (running total on device)
# INFLUX_DRAINAGE_TITLE=Drainage sensor - EcoFarm
# INFLUX_DRAINAGE_SUBTITLE=( drenaggio )

# Grafana (optional reference — Docker Compose uses repo root `.env` for GRAFANA_*)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=greenctrl-grafana-local
# GRAFANA_URL=http://localhost:3333

# Email verification (optional but recommended for auth/register)
# If SMTP is not configured, verification codes are only logged in backend logs.
EMAIL_FROM=GreenCtrl <no-reply@greenctrl.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Auth behavior
# false = users can login right after register
# true = users must verify email code first
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# true = enable /api/auth/register
AUTH_ALLOW_REGISTRATION=false
