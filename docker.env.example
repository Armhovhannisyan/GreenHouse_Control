# Optional: copy to ".env" in this folder (repo root) so docker compose uses the same
# admin password/token as backend/.env INFLUX_TOKEN after first container setup.
INFLUX_ADMIN_PASSWORD=greenctrl-influx-local
INFLUX_ADMIN_TOKEN=greenctrl-local-influx-token-replace-for-prod

# Grafana (docker compose service grafana) — login at http://localhost:3333/
# Copy these to repo root `.env` (docker compose reads it automatically).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=greenctrl-grafana-local
# Allow iframe on Precision Growing: anonymous Grafana Viewer (LAN only; set false for stricter local).
GRAFANA_EMBED_ANONYMOUS=true

# Full stack (backend + Influx + Grafana): from repo root
#   docker compose up --build -d
#   Grafana loads datasource from grafana/provisioning/datasources/influx.yaml (Flux, org greenctrl, bucket greenhouse).
